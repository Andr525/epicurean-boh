{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:epicurean:catalog:v1",
  "title": "Epicurean unified catalog v1 and complete publication envelope",
  "description": "Semantic reference, selection, hash and ownership checks are enforced by contract.mjs/publication.mjs. Schema does not authorize a production activation.",
  "oneOf": [
    {
      "$ref": "#/$defs/Catalog"
    },
    {
      "$ref": "#/$defs/Release"
    }
  ],
  "$defs": {
    "Rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "individual",
            "fixed-price",
            "selection"
          ]
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "automatic": {
          "type": "boolean"
        },
        "deferred": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind"
      ]
    },
    "Menu": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "orderingRuleId": {
          "type": "string",
          "minLength": 1
        },
        "basePriceCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "presentationGroup": {
          "type": "string"
        },
        "active": {
          "type": "boolean"
        },
        "channels": {
          "type": "array",
          "items": {
            "enum": [
              "pos",
              "digital",
              "voice"
            ]
          }
        },
        "availabilityPolicyId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sectionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "orderingRuleId",
        "basePriceCents",
        "active",
        "channels",
        "sectionIds"
      ]
    },
    "Section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "menuId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "orderingRuleId": {
          "type": "string",
          "minLength": 1
        },
        "offeringIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "menuId",
        "name",
        "orderingRuleId",
        "offeringIds"
      ]
    },
    "Offering": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sectionId": {
          "type": "string",
          "minLength": 1
        },
        "productId": {
          "type": "string",
          "minLength": 1
        },
        "priceCents": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "upchargeCents": {
          "type": "integer",
          "minimum": 0
        },
        "active": {
          "type": "boolean"
        },
        "availabilityPolicyId": {
          "type": [
            "string",
            "null"
          ]
        },
        "taxRuleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pour": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "sectionId",
        "productId",
        "priceCents",
        "upchargeCents",
        "active"
      ]
    },
    "Product": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "photos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allergens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allergenDataStatus": {
          "enum": [
            "declared",
            "unknown"
          ]
        },
        "modifierGroupIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "temperatureGroupId": {
          "type": [
            "string",
            "null"
          ]
        },
        "routeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "translations": {
          "type": "object"
        },
        "displayMetadata": {
          "type": "object"
        },
        "operationalAvailability": {
          "type": "object"
        },
        "legacy": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "allergens",
        "allergenDataStatus",
        "modifierGroupIds"
      ]
    },
    "ModifierGroup": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "priceDeltaCents": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "name",
              "priceDeltaCents"
            ]
          }
        },
        "legacy": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "min",
        "max",
        "options"
      ]
    },
    "TaxRule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ratePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "isDefault": {
          "type": "boolean"
        },
        "legacy": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "ratePercent"
      ]
    },
    "Route": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "AvailabilityPolicy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "days": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6
                }
              },
              "start": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "end": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            },
            "required": [
              "days",
              "start",
              "end"
            ]
          }
        }
      },
      "required": [
        "id",
        "timezone",
        "windows"
      ]
    },
    "Catalog": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "epicurean.catalog/v1"
        },
        "currency": {
          "const": "USD"
        },
        "menus": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Menu"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Section"
          }
        },
        "offerings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Offering"
          }
        },
        "products": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Product"
          }
        },
        "orderingRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Rule"
          }
        },
        "modifierGroups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ModifierGroup"
          }
        },
        "taxRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TaxRule"
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Route"
          }
        },
        "availabilityPolicies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AvailabilityPolicy"
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "legacySnapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "records": {
                "type": "object"
              }
            },
            "required": [
              "id",
              "records"
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "currency",
        "menus",
        "sections",
        "offerings",
        "products",
        "orderingRules",
        "modifierGroups",
        "taxRules",
        "routes",
        "availabilityPolicies",
        "provenance"
      ],
      "additionalProperties": false
    },
    "Release": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "manifest": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": "epicurean.catalog/v1"
            },
            "currency": {
              "const": "USD"
            },
            "recordCounts": {
              "type": "object",
              "properties": {
                "menus": {
                  "type": "integer",
                  "minimum": 0
                },
                "sections": {
                  "type": "integer",
                  "minimum": 0
                },
                "offerings": {
                  "type": "integer",
                  "minimum": 0
                },
                "products": {
                  "type": "integer",
                  "minimum": 0
                },
                "orderingRules": {
                  "type": "integer",
                  "minimum": 0
                },
                "modifierGroups": {
                  "type": "integer",
                  "minimum": 0
                },
                "taxRules": {
                  "type": "integer",
                  "minimum": 0
                },
                "routes": {
                  "type": "integer",
                  "minimum": 0
                },
                "availabilityPolicies": {
                  "type": "integer",
                  "minimum": 0
                },
                "provenance": {
                  "type": "integer",
                  "minimum": 0
                },
                "legacySnapshots": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "menus",
                "sections",
                "offerings",
                "products",
                "orderingRules",
                "modifierGroups",
                "taxRules",
                "routes",
                "availabilityPolicies",
                "provenance",
                "legacySnapshots"
              ]
            },
            "chunks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "hash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "collection": {
                    "enum": [
                      "menus",
                      "sections",
                      "offerings",
                      "products",
                      "orderingRules",
                      "modifierGroups",
                      "taxRules",
                      "routes",
                      "availabilityPolicies",
                      "provenance",
                      "legacySnapshots"
                    ]
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "id",
                  "hash",
                  "collection",
                  "count"
                ]
              }
            }
          },
          "required": [
            "schemaVersion",
            "currency",
            "recordCounts",
            "chunks"
          ]
        },
        "chunks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "data": {
                "type": "object",
                "properties": {
                  "collection": {
                    "type": "string"
                  },
                  "records": {
                    "type": "array",
                    "items": {}
                  }
                },
                "required": [
                  "collection",
                  "records"
                ]
              }
            },
            "required": [
              "id",
              "hash",
              "data"
            ]
          }
        }
      },
      "required": [
        "id",
        "manifest",
        "chunks"
      ]
    }
  }
}
